<?xml version="1.0" encoding="utf-8"?>
<!-- T016: AndroidManifest — permissions, service declaration, backup rules -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service (mic + cloud streaming) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- T016: dataSync type required for SSE / streaming cloud requests in foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Floating overlay window (spec 002) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- T016: Cloud AI inference — network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wake lock for continuous audio processing during sessions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notification for foreground service (required API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MeetMindApplication"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.MeetMindAssistant"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Audio processing foreground service.
            T016: foregroundServiceType updated to microphone|dataSync
            - microphone: continuous ASR during session
            - dataSync: SSE streaming from Gemini / Claude cloud providers
        -->
        <service
            android:name=".service.AudioProcessingForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

    </application>

</manifest>
